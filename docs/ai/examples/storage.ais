/// @ 1.2.1
// Mk:save / Mk:load
// Mk:save の値はブラウザに保存され、再実行しても残ります
let saved = Mk:load("visits")
var visits = if saved == null 0 else saved
visits += 1
Mk:save("visits", visits)

Ui:render([
	Ui:C:text({ text: `{visits} 回目の実行です` }),
	Ui:C:button({ text: "リセット", onClick: @() {
		Mk:remove("visits")
		Mk:toast("消しました。もう一度実行してください")
	} }),
])
