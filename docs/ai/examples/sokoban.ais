/// @ 1.2.1
// 倉庫番: 荷物（📦）をすべてゴール（🟡）に押し込めばクリア
// 操作: 矢印のボタンを押すか、盤面のマスをタップする（自分と同じ行か列のマスへ進む）
// 記号: # 壁 / . ゴール / $ 荷物 / * ゴール上の荷物 / @ 自分 / + ゴール上の自分

let LEVELS = [
	{ name: "はじめの一歩", map: [
		"#######",
		"#@ $ .#",
		"#######",
	] },
	{ name: "ふたつ並べて", map: [
		"######",
		"#.  .#",
		"# $$ #",
		"#  @ #",
		"######",
	] },
	{ name: "曲がり角", map: [
		" #####",
		"##   #",
		"#@ $ #",
		"# $ ##",
		"#. .#",
		"#####",
	] },
	{ name: "回り込み", map: [
		" #####",
		" #   ##",
		"## #$ #",
		"#  .  #",
		"# @$. #",
		"#######",
	] },
	{ name: "十字路", map: [
		"########",
		"#  .   #",
		"# $$$  #",
		"#.#@#. #",
		"#  $   #",
		"#   .  #",
		"########",
	] },
	{ name: "小部屋", map: [
		"#######",
		"#.  # #",
		"# $   #",
		"## #$ #",
		"#  @ .#",
		"# $.  #",
		"#######",
	] },
	{ name: "鏡の部屋", map: [
		"#########",
		"#   #   #",
		"# $ . $ #",
		"#.##@##.#",
		"# $ . $ #",
		"#   #   #",
		"#########",
	] },
	{ name: "遠回り", map: [
		" ######",
		" #    #",
		"##$## #",
		"#  .  #",
		"# #$#.#",
		"#   @ #",
		"#######",
	] },
]

let TILE = {
	wall: "🟫",
	floor: "⬜",
	outside: "🟫",
	goal: "🟡",
	box: "📦",
	boxOnGoal: "✅",
	player: "🐱",
}

var level = 0
var width = 0
var height = 0
var walls = []
var goals = []
var boxes = []
var inside = []
var px = 0
var py = 0
var moves = 0
var pushes = 0
var history = []
var cleared = false

let board = Ui:C:mfm({ text: "", size: 1.6, onClickEv: @(ev) { onTap(ev) } }, "board")
let status = Ui:C:text({ text: "" }, "status")
let best = Ui:C:text({ text: "", size: 0.85 }, "best")
let clearMessage = Ui:C:mfm({ text: "" }, "clearMessage")
let share = Ui:C:postFormButton({ text: "結果を投稿する", rounded: true, form: { text: "" } }, "share")
let nextButton = Ui:C:button({ text: "次のステージへ", primary: true, rounded: true, onClick: @() { load(level + 1) } }, "next")
let clearBox = Ui:C:container({
	align: "center",
	hidden: true,
	padding: 12,
	rounded: true,
	bgColor: "#86b30022",
	children: [clearMessage, nextButton, share],
}, "clearBox")
// select は default を update しても表示が変わらない（Misskey 本体と同じ）ので、ステージが変わるたびに作り直す
let selectBox = Ui:C:container({ children: [] }, "selectBox")

@makeLevelSelect() {
	Ui:C:select({
		label: "ステージを選ぶ",
		items: LEVELS.map(@(l, i) { { text: `{i + 1}. {l.name}`, value: Core:to_str(i) } }),
		default: Core:to_str(level),
		onChange: @(v) { load(v.to_num()) },
	})
}

@isWall(x, y) {
	if y < 0 || y >= height || x < 0 || x >= width return true
	walls[y][x]
}

// 自分のいる場所から壁にぶつからずに行けるマスを「部屋の中」とする（外側は暗く塗る）
@markInside() {
	inside = Arr:create(height).map(@(_row) { Arr:create(width, false) })
	var queue = [[px, py]]
	inside[py][px] = true
	loop {
		if queue.len == 0 break
		let [x, y] = queue.shift()
		each let [dx, dy], [[1, 0], [-1, 0], [0, 1], [0, -1]] {
			let nx = x + dx
			let ny = y + dy
			if !isWall(nx, ny) && !inside[ny][nx] {
				inside[ny][nx] = true
				queue.push([nx, ny])
			}
		}
	}
}

@load(n) {
	level = if n >= LEVELS.len 0 else n
	let rows = LEVELS[level].map
	height = rows.len
	width = rows.map(@(r) { r.len }).reduce(@(a, b) { Math:max(a, b) }, 0)
	walls = []
	goals = []
	boxes = []
	for let y, height {
		let chars = rows[y].to_arr()
		var wallRow = []
		var goalRow = []
		var boxRow = []
		for let x, width {
			let c = if x < chars.len chars[x] else " "
			wallRow.push(c == "#")
			goalRow.push(c == "." || c == "*" || c == "+")
			boxRow.push(c == "$" || c == "*")
			if c == "@" || c == "+" {
				px = x
				py = y
			}
		}
		walls.push(wallRow)
		goals.push(goalRow)
		boxes.push(boxRow)
	}
	markInside()
	moves = 0
	pushes = 0
	history = []
	cleared = false
	clearBox.update({ hidden: true })
	selectBox.update({ children: [makeLevelSelect()] })
	render()
}

@tile(x, y) {
	if walls[y][x] return TILE.wall
	if !inside[y][x] return TILE.outside
	if x == px && y == py return TILE.player
	if boxes[y][x] return if goals[y][x] TILE.boxOnGoal else TILE.box
	if goals[y][x] return TILE.goal
	TILE.floor
}

@render() {
	var lines = []
	for let y, height {
		var line = ""
		for let x, width {
			line = `{line}$[clickable.ev={x}_{y} {tile(x, y)}]`
		}
		lines.push(line)
	}
	board.update({ text: lines.join(Str:lf) })
	status.update({ text: `ステージ {level + 1}「{LEVELS[level].name}」 手数 {moves} / 押した回数 {pushes}` })
	let record = Mk:load(`best_{level}`)
	best.update({ text: if record == null "自己ベスト: まだありません" else `自己ベスト: {record} 手` })
}

@checkClear() {
	for let y, height {
		for let x, width {
			if boxes[y][x] && !goals[y][x] return false
		}
	}
	true
}

// 1 マス動く。動けたら true を返す
@step(dx, dy) {
	if cleared return false
	let nx = px + dx
	let ny = py + dy
	if isWall(nx, ny) return false
	if boxes[ny][nx] {
		let bx = nx + dx
		let by = ny + dy
		if isWall(bx, by) || boxes[by][bx] return false
		boxes[ny][nx] = false
		boxes[by][bx] = true
		history.push({ px: px, py: py, box: [nx, ny, bx, by] })
		pushes += 1
	} else {
		history.push({ px: px, py: py, box: null })
	}
	px = nx
	py = ny
	moves += 1
	true
}

@afterMove() {
	if checkClear() {
		cleared = true
		let record = Mk:load(`best_{level}`)
		let isBest = record == null || moves < record
		if isBest Mk:save(`best_{level}`, moves)
		let isLast = level + 1 >= LEVELS.len
		clearMessage.update({ text: `$[tada 🎉] **クリア！** {moves} 手{if isBest "（自己ベスト更新）" else ""}` })
		nextButton.update({ text: if isLast "最初のステージへ" else "次のステージへ" })
		share.update({ form: { text: `倉庫番 ステージ {level + 1}「{LEVELS[level].name}」を {moves} 手でクリアしました 📦{Str:lf}{THIS_URL}` } })
		clearBox.update({ hidden: false })
	}
	render()
}

@move(dx, dy) {
	step(dx, dy)
	afterMove()
}

// タップしたマスが自分と同じ行か列なら、そこへ向かって進めるだけ進む
@onTap(ev) {
	let [tx, ty] = ev.split("_").map(@(s) { s.to_num() })
	if tx != px && ty != py return null
	let dx = Math:sign(tx - px)
	let dy = Math:sign(ty - py)
	loop {
		if px == tx && py == ty break
		if !step(dx, dy) break
	}
	afterMove()
}

@undo() {
	if cleared || history.len == 0 return null
	let last = history.pop()
	if last.box != null {
		let [nx, ny, bx, by] = last.box
		boxes[by][bx] = false
		boxes[ny][nx] = true
		pushes -= 1
	}
	px = last.px
	py = last.py
	moves -= 1
	render()
}

Ui:render([
	Ui:C:container({
		align: "center",
		children: [
			Ui:C:text({ text: "倉庫番", size: 1.4, bold: true }),
			status,
			board,
			Ui:C:buttons({ buttons: [
				{ text: "⬆️", onClick: @() { move(0, -1) } },
			] }, "padUp"),
			Ui:C:buttons({ buttons: [
				{ text: "⬅️", onClick: @() { move(-1, 0) } },
				{ text: "⬇️", onClick: @() { move(0, 1) } },
				{ text: "➡️", onClick: @() { move(1, 0) } },
			] }, "padRow"),
			Ui:C:buttons({ buttons: [
				{ text: "1 手戻す", onClick: @() { undo() } },
				{ text: "やり直す", onClick: @() { load(level) } },
			] }, "tools"),
			clearBox,
			best,
		],
	}),
	Ui:C:folder({
		title: "遊び方",
		opened: false,
		children: [
			Ui:C:mfm({ text: `{TILE.player} を動かして {TILE.box} をすべて {TILE.goal} に押し込むとクリアです。{Str:lf}荷物は押せますが引けません。2 つ並んだ荷物も押せません。{Str:lf}盤面のマスをタップすると、同じ行か列ならそこまで進みます。` }),
		],
	}),
	selectBox,
])

load(0)
